# Copiar este archivo como `.env` y completar con los datos reales.

# PostgreSQL local:
#   postgresql://USUARIO:CONTRASEÑA@localhost:5432/urbania?schema=public
# PostgreSQL en la nube (Neon, Render, etc.) normalmente exige SSL:
#   postgresql://USUARIO:CONTRASEÑA@HOST/urbania?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/urbania?schema=public"

PORT=3000

# Autenticación de desarrollo (TEMPORAL hasta integrar el JWT de Persona 1).
# Con DEV_AUTH=true se puede actuar enviando la cabecera `x-user-id: <uuid>`;
# el rol se lee de la base de datos. Nunca activar en producción.
DEV_AUTH=true
