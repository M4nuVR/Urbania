// Esquema común de Urbania (un solo archivo para todo el equipo).
// Cada persona agrega o completa sus modelos aquí y crea su propia migración
// con `npm run prisma:migrate -- --name <descripcion>`.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums compartidos
// ---------------------------------------------------------------------------

enum Role {
  CITIZEN
  AUTHORITY
  ADMIN
}

enum ReportStatus {
  REPORTED
  UNDER_REVIEW
  IN_PROGRESS
  RESOLVED
}

enum NotificationType {
  ASSIGNED
  STATUS_CHANGED
}

// ---------------------------------------------------------------------------
// Persona 1 — Usuarios (base mínima: Persona 1 completa los campos que falten)
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(CITIZEN)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  reports             Report[]       @relation("ReportCitizen")
  assignmentsReceived Assignment[]   @relation("AssignmentAuthority")
  assignmentsMade     Assignment[]   @relation("AssignmentAdmin")
  trackingChanges     Tracking[]
  notifications       Notification[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Persona 2 — Reportes (base mínima: Persona 2 completa los campos que falten)
// ---------------------------------------------------------------------------

model Report {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  description String
  status      ReportStatus @default(REPORTED)
  citizenId   String       @map("citizen_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  citizen       User           @relation("ReportCitizen", fields: [citizenId], references: [id])
  assignment    Assignment?
  tracking      Tracking[]
  notifications Notification[]

  @@index([citizenId])
  @@index([status])
  @@map("reports")
}

// ---------------------------------------------------------------------------
// Persona 4 — Atención, seguimiento y notificaciones
// ---------------------------------------------------------------------------

// MVP: una asignación vigente por reporte (reportId único).
model Assignment {
  id          String   @id @default(uuid()) @db.Uuid
  reportId    String   @unique @map("report_id") @db.Uuid
  authorityId String   @map("authority_id") @db.Uuid
  assignedBy  String   @map("assigned_by") @db.Uuid
  assignedAt  DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  report    Report @relation(fields: [reportId], references: [id], onDelete: Restrict)
  authority User   @relation("AssignmentAuthority", fields: [authorityId], references: [id], onDelete: Restrict)
  admin     User   @relation("AssignmentAdmin", fields: [assignedBy], references: [id], onDelete: Restrict)

  @@index([authorityId])
  @@map("assignments")
}

// Historial inmutable: no se exponen rutas de edición ni borrado.
// previousStatus es nulo solo en la entrada inicial REPORTED.
model Tracking {
  id             String        @id @default(uuid()) @db.Uuid
  reportId       String        @map("report_id") @db.Uuid
  previousStatus ReportStatus? @map("previous_status")
  newStatus      ReportStatus  @map("new_status")
  changedBy      String        @map("changed_by") @db.Uuid
  observation    String?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  report Report @relation(fields: [reportId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [changedBy], references: [id], onDelete: Restrict)

  @@index([reportId, createdAt])
  @@map("tracking")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  reportId  String           @map("report_id") @db.Uuid
  type      NotificationType
  message   String
  readAt    DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  report Report @relation(fields: [reportId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@map("notifications")
}
